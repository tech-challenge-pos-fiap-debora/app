# Copia para .env (na raiz) e ajusta os valores. O Docker Compose usa este ficheiro como .env
# por defeito para interpolar variáveis no docker-compose.yml (serviço api).
#
# DATABASE_URL: na tua máquina (yarn migrate:up, yarn start:dev) usa localhost:5432.
# Dentro do contentor da api o compose define DATABASE_URL para o host postgres.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techchallenge

# Os testes de integração não usam esta variável: eles recriam o schema no início
# e no fim, então a URL deles é fixa no código, em
# test/integration/helpers/database-url.ts.

JWT_SECRET=altere-este-segredo
JWT_EXPIRES_IN=1d
PORT=3000
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin
